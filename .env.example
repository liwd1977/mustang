# 通义千问 / DashScope（OpenAI 兼容模式）
# 参考 Consult_Claude：DEFAULT_LLM_PROVIDER=qwen + OPENAI_API_KEY + LLM_BASE_URL
OPENAI_API_KEY=your_dashscope_api_key_here
DEFAULT_LLM_PROVIDER=qwen
DEFAULT_MODEL_NAME=qwen-vl-max
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_REQUEST_TIMEOUT=180

# VLM 专用模型（流程图识别，可与文本模型不同）
VLM_MODEL_NAME=qwen-vl-max

# 文本 LLM（表单语义匹配等）
TEXT_MODEL_NAME=qwen-plus

# 表单来源网址（办事指南表单库，待配置实际 URL）
FORM_SOURCE_BASE_URL=

# 数据与输出目录（相对项目根）
DATA_DIR=./data
OUTPUT_DIR=./output

# 神笔平台（资料到位后启用）
# SHENBI_BASE_URL=
# SHENBI_API_TOKEN=
# SHENBI_TENANT_ID=
