# 通义千问 / DashScope（OpenAI 兼容模式）
# VLM 与文本模型共用同一 Key，以下环境变量任选其一：
#   QWEN_API_KEY  /  OPENAI_API_KEY  /  DASHSCOPE_API_KEY
# 系统环境变量优先，.env 作为补充（override=False）
QWEN_API_KEY=your_dashscope_api_key_here
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=qwen
DEFAULT_MODEL_NAME=qwen-vl-max
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_REQUEST_TIMEOUT=180

# VLM 专用模型（流程图识别，可与文本模型不同）
VLM_MODEL_NAME=qwen-vl-max

# 文本 LLM（表单语义匹配等）
TEXT_MODEL_NAME=qwen-plus

# 野马 OA（致远 Seeyon）
OA_BASE_URL=http://117.190.14.58:8899
OA_USERNAME=1号
OA_PASSWORD=your_oa_password_here
OA_TEMPLATE_URL=http://117.190.14.58:8899/seeyon/collaboration/collaboration.do?method=newColl&rescode=F01_newColl&showTab=true&recommendMenuId=-4140425781984149261&menuSummary=add&portalId=1&_resourceCode=F01_newColl

# OA 访问代理（Playwright 不自动使用系统代理；与 Windows/Clash 代理端口一致）
OA_PROXY=http://127.0.0.1:7897

# 表单来源网址（与 OA 模板页一致时可复用 OA_TEMPLATE_URL）
FORM_SOURCE_BASE_URL=

# 数据与输出目录（相对项目根）
DATA_DIR=./data
OUTPUT_DIR=./output
LOG_DIR=./logs

# VLM 解析流程数量上限（0=不限制全部解析）
VLM_FLOW_LIMIT=0

# 办事指南 parse 缓存策略（开发试验默认 false）
# false=写入前 Word 有更新则自动重新解析，且单次解析不复用 VLM 流程级缓存
# true=批量模式：复用 parse 缓存加速；Word 更新后请在「流程解析」页手动重新解析
GUIDE_PARSE_USE_CACHE=false

# 流程任务表（B=OA表单, C/D=流程名）
FLOW_TASK_TABLE_NAME=野马集团流程任务表0807.xlsx

# 神笔平台（流程写入）
SHENBI_BASE_URL=https://www.cloudschool.cn/gateway
SHENBI_API_TOKEN=qhGhcPqf7H6xQI2u
SHENBI_APP_ID=920b5e4c78ad803453d2da15060172c5
SHENBI_SSL_VERIFY=false
# 从浏览器 DevTools 复制 Cookie（如 SESSION=xxx），与 fighter-auth-token 配套
SHENBI_SESSION_COOKIE=SESSION=SESSION
# 访问神笔平台代理；留空则使用 OA_PROXY
# SHENBI_PROXY=http://127.0.0.1:7897
